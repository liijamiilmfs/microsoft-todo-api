{
  "name": "microsoft-todo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight Microsoft To Do client for Microsoft Graph v1.0.",
  "exports": {
    ".": "./src/todoClient.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.ts --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "example:auth": "node --env-file-if-exists=.env examples/auth-check.ts",
    "example:basic": "node --env-file-if-exists=.env examples/example-basic.ts",
    "example:shopping": "node --env-file-if-exists=.env examples/example-shopping.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.1",
    "@azure/msal-node-extensions": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
